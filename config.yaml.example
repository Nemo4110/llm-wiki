# LLM-Wiki 配置文件
# 将此文件复制为 config.yaml 并修改为你的环境

lint:
  depth:
    # 启发式内容深度检查默认启用，但只报告 warning，不改变 lint 退出码。
    enabled: true
    min_knowledge_chars: 500
    min_meaningful_paragraphs: 3
    multi_source_threshold: 3
    multi_source_min_knowledge_chars: 800
    source_volume_threshold: 10000
    compression_ratio_warning: 0.01
    extreme_source_volume_threshold: 20000
    extreme_compression_max_knowledge_chars: 1500
    # 下列标签默认跳过深度检查；页面也可用 frontmatter `lint_depth: skip` 显式豁免。
    skip_tags:
      - QRF

embedding:
  # 是否启用 embedding 检索（默认 false，保持纯符号导航）
  enabled: false

  # 提供者: ollama | openai | mcp
  provider: ollama

  # 模型名称（Provider 特定）
  model: nomic-embed-text

  ollama:
    base_url: http://localhost:11434

  openai:
    api_key: "${OPENAI_API_KEY}"
    # 可选：自定义 endpoint（如兼容 OpenAI 的第三方服务）
    # base_url: https://api.openai.com/v1

  mcp:
    # 传输方式: stdio | sse
    transport: stdio
    # stdio 配置
    command: python
    args: ["-m", "my_embedding_server"]
    env: {}
    # sse 配置
    # url: http://localhost:3000/sse
    # 工具名（可选，留空则自动发现）
    tool_name: embed

zotero_enrichment:
  # 显式运行 zotero-refresh 时可用；enabled 供后续调度器判断是否启用。
  enabled: false
  cache_path: var/zotero-enrichment.sqlite
  request_timeout_seconds: 20
  max_concurrency: 3
  candidate_threshold: 0.92
  candidate_margin: 0.05
  verification_threshold: 0.72

  crossref:
    # 推荐使用联系邮箱进入 Crossref polite pool。
    mailto: "${CROSSREF_MAILTO:-}"

  openalex:
    # 当前无 key 也可尝试请求；配置 key 可获得更稳定的额度。
    api_key: "${OPENALEX_API_KEY:-}"
    mailto: "${OPENALEX_MAILTO:-}"

  stale_after_days:
    citations: 90
    missing_doi: 30
    verified_doi: 365
    preprint_publication: 30
    journal_metrics: 365

  apply:
    # 只管理 llm-wiki:* 状态标签，不触碰用户标签。
    add_status_tags: true
    # 仅规范空 URL 或错误的 doi.org URL；保留 publisher/arXiv URL。
    normalize_doi_url: true

  # 临时：直连 Zotero 10 本地写 API（zotero-refresh --write-backend local 或受限 zotero-writeback）。
  # 读仍走 MCP；仅审核后的写可直连本地。可先跑 zotero-local-auth 持久授权，
  # 或在 zotero-writeback apply 时用 --memory-authorize 仅保存在当前进程。
  # 上游 zotero-mcp 采纳本地写后移除此段。
  local:
    base_url: "http://127.0.0.1:23119"

zotero_import:
  # sources/zotero/ 别名命名模板（方案五;仅别名,不含 wiki 页面命名）。
  # 通配符: %a 主作者 %y 年份 %t 标题 %c 分类层级路径 %b CiteKey %T 条目类型, %% 为字面值。
  # 所有替换值都经跨平台清洗(去音标/非法字符/字节截断);用 `agent-bridge.py zotero-alias` 渲染。
  alias_pattern: "%c/%t"

retrieval:
  # 混合搜索返回的 top-k 结果数
  top_k: 10

  # 各信号权重（总和不必为 1，仅影响相对比例）
  keyword_weight: 0.3
  vector_weight: 0.5
  link_weight: 0.2

  # 是否启用链接遍历增强
  enable_link_traversal: true

# 能力契约:对每个 agent-bridge 命令做收紧覆盖(可选)。
# 默认契约声明在 src/llm_wiki/capabilities.py;此处只能收紧——
# 禁用命令或缩小 write_scope,放宽会被拒绝。
# 查看有效契约:python scripts/agent-bridge.py capabilities
capabilities: {}
# 示例:
# capabilities:
#   apply-bundle:
#     enabled: false              # 完全禁用某命令
#   merge:
#     write_scope: ["wiki/"]      # 缩小写范围(不能超出默认值)
